/* The @S arrival census: what an empty `securitySinks` array is evidence for. No attacker source read, no sink
   ran, only the page's own strings arrived, or taint arrived behind an unforgeable check and its search waits
   on a sender at the pinned origin — four readings with opposite actions, which these rows split.
   solver/metrics.h states the grammar. `_sourceReads` counts attacker-source values minted
   (concolic_source_wrap); the sink rows count exploration-flow arrivals at detect_sink, `_sinkTainted` a
   subset of `_sinkReached` and the two after it disjoint subsets of `_sinkTainted`. */
METRIC(source_reads,    "_sourceReads",    LIFETIME, "value",   AGENT, "solver/concolic.c", INT)
METRIC(sink_reached,    "_sinkReached",    LIFETIME, "arrival", AGENT, "solver/solve.c", INT)
METRIC(sink_tainted,    "_sinkTainted",    LIFETIME, "arrival", AGENT, "solver/solve.c", INT)
METRIC(sink_needs_sender, "_sinkNeedsSender", LIFETIME, "arrival", AGENT, "solver/solve.c", INT)
/* …and the tainted arrivals whose root declares no source (an environment unknown, a driven body's argument),
   which open no search because nothing delivers a candidate there. Disjoint from `_sinkNeedsSender`. */
METRIC(sink_undeclared, "_sinkUndeclared", LIFETIME, "arrival", AGENT, "solver/solve.c", INT)
IDENTITY_LE(sink_tainted,    sink_reached)
IDENTITY_LE(sink_needs_sender, sink_tainted)
IDENTITY_LE(sink_undeclared, sink_tainted)
