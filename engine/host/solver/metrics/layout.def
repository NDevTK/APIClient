/* The layout job census (core/layout/layout_job.h). `_layoutStackedAsks` counts the stacked questions asked,
   of every kind layout_job_ask takes; `_layoutStackedServed` those the memo answered and
   `_layoutStackedDeferred` those pushed suspended for their drive. The `_layoutBf*` rows count the CSS 2.1
   §9.4.1 kinds among them; `_layoutBfReplays` counts bodies that returned "not yet" and so run again from their
   start. `_layoutJobsStep` counts jobs a step machine owned (a fork's clone of one is one too),
   `_layoutJobRests` the rest points a driver took with its job alive, and `_layoutServedAcrossRest` the memo
   answers of any stacked kind recorded before such a rest and served after it: a nonzero value is a job that
   suspended and resumed with its memo. `_layoutLineItems` counts the items line box fills took under a resting drive and `_layoutFillRests` the asks a fill answered "not yet"
   because those were spent: a nonzero value is a CSS 2.2 §9.4.2 context that rested inside its fill.
   `_layoutFillsShed` counts complete fills RAM pressure released and `_layoutFillsRederived` those an ask then
   re-derived in a residency span; each re-derivation follows its own shed.
   `_layoutClientExtentAsks` counts the reads of CSSOM VIEW §6's `clientWidth`/`clientHeight` that reached step
   3's padding edge and `_layoutClientExtentRests` the rests those reads took, a subset of `_layoutJobRests`, so
   one read takes 1 + rests/asks activations on average. `_layoutClientRectsAsks` and `_layoutClientRectsRests`
   count the same for §6's getClientRects() and getBoundingClientRect(), and `_layoutRangeRectsAsks` and
   `_layoutRangeRectsRests` for §9's Range members, and `_layoutMouseOffsetAsks` and `_layoutMouseOffsetRests`
   for §10's MouseEvent offsetX/offsetY. `_layoutPaintRests` counts the rests
   update the rendering step 22's paint took between CSS 2.1 §E.2's offers, a subset of `_layoutJobRests`.
   `_layoutRunMeasures` counts css-sizing-3 §5.1 run measurements answered, and `_layoutRunMeasuredAgain` those
   whose run another record of the same job (its own or another grid row context's) already held answered: a
   run no context decided is measured once per job, so a nonzero value on such a document is a lost share. */
METRIC(stacked_asks,       "_layoutStackedAsks",      LIFETIME, "ask",  AGENT, "core/layout/layout_job.c", INT)
METRIC(stacked_served,     "_layoutStackedServed",    LIFETIME, "ask",  AGENT, "core/layout/layout_job.c", INT)
METRIC(stacked_deferred,   "_layoutStackedDeferred",  LIFETIME, "ask",  AGENT, "core/layout/layout_job.c", INT)
METRIC(bf_asks,            "_layoutBfAsks",           LIFETIME, "ask",  AGENT, "core/layout/layout_job.c", INT)
METRIC(bf_served,          "_layoutBfServed",         LIFETIME, "ask",  AGENT, "core/layout/layout_job.c", INT)
METRIC(bf_deferred,        "_layoutBfDeferred",       LIFETIME, "ask",  AGENT, "core/layout/layout_job.c", INT)
METRIC(bf_replays,         "_layoutBfReplays",        LIFETIME, "body", AGENT, "core/layout/layout_job.c", INT)
METRIC(jobs_step,          "_layoutJobsStep",         LIFETIME, "job",  AGENT, "core/layout/layout_job.c", INT)
METRIC(job_rests,          "_layoutJobRests",         LIFETIME, "rest", AGENT, "core/layout/layout_job.c", INT)
METRIC(served_across_rest, "_layoutServedAcrossRest", LIFETIME, "ask",  AGENT, "core/layout/layout_job.c", INT)
METRIC(line_items,         "_layoutLineItems",        LIFETIME, "item", AGENT, "core/layout/layout_job.c", INT)
METRIC(fill_rests,         "_layoutFillRests",        LIFETIME, "ask",  AGENT, "core/layout/line_box.c",   INT)
METRIC(fills_shed,         "_layoutFillsShed",        LIFETIME, "fill", AGENT, "core/layout/line_box.c",   INT)
METRIC(fills_rederived,    "_layoutFillsRederived",   LIFETIME, "fill", AGENT, "core/layout/line_box.c",   INT)
METRIC(client_extent_asks,  "_layoutClientExtentAsks",  LIFETIME, "ask",  AGENT, "core/dom/element_view.c", INT)
METRIC(client_extent_rests, "_layoutClientExtentRests", LIFETIME, "rest", AGENT, "core/dom/element_view.c", INT)
METRIC(client_rects_asks,   "_layoutClientRectsAsks",   LIFETIME, "ask",  AGENT, "core/dom/element_view.c", INT)
METRIC(client_rects_rests,  "_layoutClientRectsRests",  LIFETIME, "rest", AGENT, "core/dom/element_view.c", INT)
METRIC(range_rects_asks,    "_layoutRangeRectsAsks",    LIFETIME, "ask",  AGENT, "core/dom/range.c",        INT)
METRIC(range_rects_rests,   "_layoutRangeRectsRests",   LIFETIME, "rest", AGENT, "core/dom/range.c",        INT)
METRIC(mouse_offset_asks,   "_layoutMouseOffsetAsks",   LIFETIME, "ask",  AGENT, "core/events/mouse_event.c", INT)
METRIC(mouse_offset_rests,  "_layoutMouseOffsetRests",  LIFETIME, "rest", AGENT, "core/events/mouse_event.c", INT)
METRIC(scroll_area_asks,    "_layoutScrollAreaAsks",    LIFETIME, "ask",  AGENT, "core/dom/element_view.c", INT)
METRIC(scroll_area_rests,   "_layoutScrollAreaRests",   LIFETIME, "rest", AGENT, "core/dom/element_view.c", INT)
METRIC(paint_rests,         "_layoutPaintRests",         LIFETIME, "rest",  AGENT, "core/rendering/rendering.c", INT)
METRIC(run_measures,        "_layoutRunMeasures",        LIFETIME, "measurement", AGENT, "core/layout/intrinsic_size.c", INT)
METRIC(run_measured_again,  "_layoutRunMeasuredAgain",   LIFETIME, "measurement", AGENT, "core/layout/intrinsic_size.c", INT)
IDENTITY_LE(stacked_served,     stacked_asks)
IDENTITY_LE(fills_rederived,    fills_shed)
IDENTITY_LE(stacked_deferred,   stacked_asks)
IDENTITY_LE(bf_asks,            stacked_asks)
IDENTITY_LE(bf_served,          stacked_served)
IDENTITY_LE(bf_deferred,        stacked_deferred)
IDENTITY_LE(bf_served,          bf_asks)
IDENTITY_LE(bf_deferred,        bf_asks)
IDENTITY_LE(served_across_rest, stacked_served)
IDENTITY_LE(client_extent_rests, job_rests)
IDENTITY_LE(client_rects_rests, job_rests)
IDENTITY_LE(range_rects_rests, job_rests)
IDENTITY_LE(mouse_offset_rests, job_rests)
IDENTITY_LE(scroll_area_rests, job_rests)
IDENTITY_LE(paint_rests, job_rests)
IDENTITY_LE(run_measured_again, run_measures)
