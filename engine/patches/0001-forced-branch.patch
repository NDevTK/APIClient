diff --git a/src/forced-exec/forced-exec.h b/src/forced-exec/forced-exec.h
new file mode 100644
index 0000000..8e5f90a
--- /dev/null
+++ b/src/forced-exec/forced-exec.h
@@ -0,0 +1,61 @@
+// Forced-execution controller (analysis only). Process-global, header-
+// only (no BUILD.gn change), portable: <cstdlib>/<cstdio> work under
+// Emscripten (the single wasm build) as well as native. The driver
+// drives it purely via env per run; the engine is re-instantiated per
+// schedule, so there is no in-engine state to snapshot.
+#ifndef V8_FORCED_EXEC_FORCED_EXEC_H_
+#define V8_FORCED_EXEC_FORCED_EXEC_H_
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+namespace v8 {
+namespace internal {
+
+class ForcedExec {
+ public:
+  static ForcedExec& Get() {
+    static ForcedExec instance;
+    return instance;
+  }
+  // |orig_cond| and the return are 0/1. When disabled this is the
+  // identity. When enabled it follows the schedule; past the schedule
+  // it takes 0 and reports the frontier index so the driver can flip
+  // it on the next run.
+  int Decide(int orig_cond, int site) {
+    if (!enabled_) return orig_cond;
+    int d;
+    if (cursor_ < sched_.size()) {
+      d = sched_[cursor_] == '1' ? 1 : 0;
+    } else {
+      d = 0;
+      if (trace_) std::fprintf(trace_, "F %zu %d\n", cursor_, site);
+    }
+    if (trace_) {
+      std::fprintf(trace_, "B %d %d\n", site, d);
+      std::fflush(trace_);
+    }
+    ++cursor_;
+    return d;
+  }
+
+ private:
+  ForcedExec() {
+    const char* e = std::getenv("V8_FORCED_EXEC");
+    enabled_ = e != nullptr && e[0] == '1';
+    const char* s = std::getenv("V8_FORCED_SCHEDULE");
+    if (s != nullptr) sched_ = s;
+    const char* t = std::getenv("V8_FORCED_TRACE");
+    trace_ = (t != nullptr && t[0] != '\0') ? std::fopen(t, "a") : stderr;
+  }
+  bool enabled_ = false;
+  std::string sched_;
+  std::size_t cursor_ = 0;
+  std::FILE* trace_ = nullptr;
+};
+
+}  // namespace internal
+}  // namespace v8
+
+#endif  // V8_FORCED_EXEC_FORCED_EXEC_H_
